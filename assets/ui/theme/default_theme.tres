[gd_resource type="Theme" format=3]

[sub_resource type="SystemFont" id="SystemFont_cjk"]
font_names = PackedStringArray("Noto Sans CJK SC", "Source Han Sans SC", "Microsoft YaHei", "PingFang SC", "WenQuanYi Micro Hei", "sans-serif")
antialiasing = 1
subpixel_positioning = 0

[sub_resource type="StyleBoxFlat" id="StyleBox_panel"]
content_margin_left = 16.0
content_margin_top = 12.0
content_margin_right = 16.0
content_margin_bottom = 12.0
bg_color = Color(0.11, 0.12, 0.14, 0.92)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.36, 0.39, 0.44, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="StyleBox_button_normal"]
content_margin_left = 14.0
content_margin_top = 8.0
content_margin_right = 14.0
content_margin_bottom = 8.0
bg_color = Color(0.2, 0.22, 0.26, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="StyleBox_button_hover"]
content_margin_left = 14.0
content_margin_top = 8.0
content_margin_right = 14.0
content_margin_bottom = 8.0
bg_color = Color(0.28, 0.31, 0.37, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="StyleBox_button_focus"]
draw_center = false
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.95, 0.8, 0.35, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[resource]
default_font = SubResource("SystemFont_cjk")
default_font_size = 24
Button/styles/normal = SubResource("StyleBox_button_normal")
Button/styles/hover = SubResource("StyleBox_button_hover")
Button/styles/pressed = SubResource("StyleBox_button_normal")
Button/styles/focus = SubResource("StyleBox_button_focus")
Label/colors/font_color = Color(0.92, 0.92, 0.9, 1)
PanelContainer/styles/panel = SubResource("StyleBox_panel")
