; Engine configuration file.
; Pinned engine: Godot 4.7.2.stable (see docs/decisions.md D-001).

config_version=5

[application]

config/name="Everyday City"
config/description="都市普通人生活模拟（工作名）"
config/version="0.7.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

EventBus="*res://scripts/app/game_event_bus.gd"
GameSession="*res://scripts/app/game_session.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[everyday_city]

content/root="res://content"
content/default_city_id="CN_LINCHUAN"

[gui]

theme/custom="res://assets/ui/theme/default_theme.tres"

