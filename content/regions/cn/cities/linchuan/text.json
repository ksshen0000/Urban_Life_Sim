    {
      "id": "npc.chen_yu.name",
      "zh_CN": "陈雨"
    },
    {
      "id": "npc.chen_yu.role",
      "zh_CN": "便利店店员 · 住你楼上"
    },
    {
      "id": "npc.landlord_wang.name",
      "zh_CN": "王阿姨"
    },
    {
      "id": "npc.landlord_wang.role",
      "zh_CN": "房东"
    },
    {
      "id": "npc.lao_zhou.name",
      "zh_CN": "老周"
    },
    {
      "id": "npc.lao_zhou.role",
      "zh_CN": "仓库老员工"
    },
    {
      "id": "dlg.landlord_intro.start",
      "zh_CN": "“新来的吧？我姓王，这栋楼的次卧在出租。押金六百，房租一周六百，到日子自动从你账上扣，别拖。想租就到出租屋门口签。”"
    },
    {
      "id": "dlg.landlord_intro.ok",
      "zh_CN": "“好的，王阿姨。”"
    },
    {
      "id": "dlg.landlord_intro.bargain",
      "zh_CN": "“能便宜点吗？”"
    },
    {
      "id": "dlg.landlord_intro.bargain_reply",
      "zh_CN": "王阿姨笑了：“这价在老城已经很实在了。你先住着，好好找活儿干，比什么都强。”"
    },
    {
      "id": "dlg.landlord_intro.fine",
      "zh_CN": "“……也是。”"
    },
    {
      "id": "dlg.landlord_chat.start",
      "zh_CN": "王阿姨正坐在小板凳上择菜：“吃了没？”"
    },
    {
      "id": "dlg.landlord_chat.chat",
      "zh_CN": "陪她聊几句家常"
    },
    {
      "id": "dlg.landlord_chat.bye",
      "zh_CN": "打个招呼就走"
    },
    {
      "id": "dlg.chen_intro.start",
      "zh_CN": "一个扎马尾的女孩抬头看你：“新搬来的吧？我是陈雨，住你楼上。店里最近缺人，公告栏上贴了招工，你要是在找活儿，可以去看看。”"
    },
    {
      "id": "dlg.chen_intro.thanks",
      "zh_CN": "“谢谢，我这就去看看。”"
    },
    {
      "id": "dlg.chen_intro.nod",
      "zh_CN": "“嗯，好。”"
    },
    {
      "id": "dlg.chen_chat.start",
      "zh_CN": "陈雨：“今天怎么样？还习惯吗？”"
    },
    {
      "id": "dlg.chen_chat.talk",
      "zh_CN": "聊聊这几天的事"
    },
    {
      "id": "dlg.chen_chat.bye",
      "zh_CN": "“有点累，先走了。”"
    },
    {
      "id": "dlg.zhou_intro.start",
      "zh_CN": "一个四十多岁的男人递给你一副线手套：“新来的？我是老周。搬箱子用腿使劲，别用腰，不然干不了一个月。”"
    },
    {
      "id": "dlg.zhou_intro.thanks",
      "zh_CN": "“谢谢周师傅。”"
    },
    {
      "id": "dlg.zhou_intro.nod",
      "zh_CN": "点点头，接过手套"
    },
    {
      "id": "dlg.zhou_chat.start",
      "zh_CN": "老周擦了把汗：“今天货多，悠着点干。”"
    },
    {
      "id": "dlg.zhou_chat.chat",
      "zh_CN": "跟他聊两句"
    },
    {
      "id": "dlg.zhou_chat.bye",
      "zh_CN": "“好，先走了。”"
    },
    {
      "id": "dlg.arrival.start",
      "zh_CN": "你拎着旅行包下了公交。临川老城比想象中旧一些，路边的梧桐叶落了一地。兜里还有一千五百块。\n先找个地方住下吧——听说左上角那栋楼有次卧在出租。"
    },
    {
      "id": "dlg.arrival.go",
      "zh_CN": "出发"
    },
    {
      "id": "dlg.dinner.start",
      "zh_CN": "陈雨发来消息：“下班一起去老街快餐吃个饭？我请不起，AA 哈，大概三十块。”"
    },
    {
      "id": "dlg.dinner.go",
      "zh_CN": "“好啊，一起去。”（¥30）"
    },
    {
      "id": "dlg.dinner.skip",
      "zh_CN": "“这次算了，最近想省点钱。”"
    },
    {
      "id": "dlg.warehouse.start",
      "zh_CN": "公告栏上新贴了一张启事：工业区仓库招分拣员，时薪 32 元，五小时一班。要坐 12 路过去，单程三块。"
    },
    {
      "id": "dlg.warehouse.ok",
      "zh_CN": "记下了"
    },
    {
      "id": "dlg.rent6.start",
      "zh_CN": "王阿姨发来消息：“明天交房租哈，六百，从你账上自动扣，记得留够钱。”"
    },
    {
      "id": "dlg.rent6.ok",
      "zh_CN": "“知道了，王阿姨。”"
    },
    {
      "id": "dlg.overdue.start",
      "zh_CN": "王阿姨发来消息：“房租还没到账哦。手头紧的话先跟我说一声，别躲着。”"
    },
    {
      "id": "dlg.overdue.sorry",
      "zh_CN": "“对不起，我会尽快补上。”"
    },
    {
      "id": "dlg.overdue.silent",
      "zh_CN": "先不回"
    },
    {
